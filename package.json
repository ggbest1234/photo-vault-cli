{
  "name": "photo-vault-cli",
    "version": "0.9.1",
  "description": "CLI tool for organizing photo folders using CLIP AI tagging",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "photo-vault": "dist/index.js"
  },
  "scripts": {
      "dev": "tsx src/index.ts",
      "build": "tsc && npm run copy-data",
      "copy-data": "node -e \"require('fs').cpSync('src/data','dist/data',{recursive:true})\"",
      "start": "node dist/index.js",
      "test": "node test/smoke.js"
    },
  "keywords": [
    "clip",
    "ai",
    "photo",
    "organize",
    "tagging"
  ],
  "author": "Ryan",
  "license": "MIT",
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "exifr": "^7.1.3",
    "heic-decode": "^2.1.0",
    "ora": "^8.0.1",
    "p-limit": "^6.1.0",
    "sharp": "^0.35.1",
    "undici": "^8.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
